# Copie para .env e preencha. O .env nunca vai para o git.

# Credencial da Anthropic (ou use `ant auth login`, que o SDK detecta sozinho)
ANTHROPIC_API_KEY=

# API local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_CORS=http://localhost:5299,http://127.0.0.1:5299
# Opcional: fixe o token do HUD; se vazio, um é gerado em dados/.token
JARVIS_TOKEN=

# Cérebro e orçamento
JARVIS_MODELO_SIMPLES=claude-haiku-5-5
JARVIS_MODELO_MEDIO=claude-sonnet-5-5
JARVIS_MODELO_COMPLEXO=claude-opus-5-5
JARVIS_BUDGET_USD=15
JARVIS_NOME=Senhor

# Proatividade: monitores, lembretes e notificações do Windows (0 desliga)
JARVIS_PROATIVO=1
# Pastas que as ferramentas de arquivo podem ler e de onde o JARVIS pode mover arquivos (separadas por ;).
# Vazio = padrão: Documents, OneDrive\Documentos, Downloads, Desktop, OneDrive\Desktop,
# OneDrive\Área de Trabalho (as que existirem) e a pasta do projeto.
# ATENÇÃO: definir esta variável SUBSTITUI a lista padrão inteira, não soma a ela. Liste todas as pastas que
# quiser manter. Pasta inexistente é ignorada sem aviso. JARVIS_ARQUIVO continua sendo somado para leitura.
# Exemplo (mantém Documentos e Downloads, troca o Desktop por D:\Projetos):
# JARVIS_PASTAS=C:\Users\Veloso\Documents;C:\Users\Veloso\Downloads;D:\Projetos
JARVIS_PASTAS=
# Para onde o JARVIS move arquivos (reversível) e salva os arquivos gerados. Padrão: D:\JARVIS-Arquivo
JARVIS_ARQUIVO=
# Base de conhecimento do especialista (uma subpasta por área). Padrão: D:\JARVIS-Conhecimento
JARVIS_CONHECIMENTO=
# Minutos parados até a conversa ser arquivada e começar outra (a memória guarda a continuidade)
JARVIS_SESSAO_OCIOSA_MIN=30

# Opcional: salt da pseudonimização de nomes; se vazio, um é gerado em dados/.pii_salt
JARVIS_PII_SALT=
