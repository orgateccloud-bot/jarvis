# Copie para .env e preencha. O .env nunca vai para o git.

# Credencial da Anthropic (ou use `ant auth login`, que o SDK detecta sozinho)
ANTHROPIC_API_KEY=

# API local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_CORS=http://localhost:5299,http://127.0.0.1:5299
# Opcional: fixe o token do HUD; se vazio, um é gerado em dados/.token
JARVIS_TOKEN=

# Cérebro e orçamento
JARVIS_MODELO_SIMPLES=claude-haiku-5-5
JARVIS_MODELO_MEDIO=claude-sonnet-5-5
JARVIS_MODELO_COMPLEXO=claude-opus-5-5
# Topo da complexidade: Fable 5.1 (2,5x o preço do Opus). Pontuação mínima calibrada para ~5% das perguntas;
# suba para usar menos o Fable. O prefixo /fable força esta camada; no modo economia ela desce para o Opus.
JARVIS_MODELO_FABLE=claude-fable-5-1
JARVIS_FABLE_PONTOS=4
JARVIS_BUDGET_USD=30
JARVIS_NOME=Senhor

# Proatividade: monitores, lembretes e notificações do Windows (0 desliga)
JARVIS_PROATIVO=1
# Pastas que as ferramentas de arquivo podem ler e de onde o JARVIS pode mover arquivos (separadas por ;).
# Vazio = padrão: Documents, OneDrive\Documentos, Downloads, Desktop, OneDrive\Desktop,
# OneDrive\Área de Trabalho (as que existirem) e a pasta do projeto.
# ATENÇÃO: definir esta variável SUBSTITUI a lista padrão inteira, não soma a ela. Liste todas as pastas que
# quiser manter. Pasta inexistente é ignorada sem aviso. JARVIS_ARQUIVO continua sendo somado para leitura.
# Exemplo (mantém Documentos e Downloads, troca o Desktop por D:\Projetos):
# JARVIS_PASTAS=C:\Users\Veloso\Documents;C:\Users\Veloso\Downloads;D:\Projetos
JARVIS_PASTAS=
# Para onde o JARVIS move arquivos (reversível) e salva os arquivos gerados. Padrão: D:\JARVIS-Arquivo
JARVIS_ARQUIVO=
# Base de conhecimento do especialista (uma subpasta por área). Padrão: D:\JARVIS-Conhecimento
JARVIS_CONHECIMENTO=
# Perfil só Trilhum (padrão deste branch): só o Trilhum e o Direito, com a base jurídica do JARVIS-IurisNotitia
# (JARVIS_CONHECIMENTO), sem ler nem mexer no Windows, sem web e sem sandbox. 0 = perfil completo do JARVIS.
# JARVIS_SO_TRILHUM=1
# Áreas da base que este JARVIS consulta (as jurídicas)
# JARVIS_AREAS=juridico,oab,tributario
# Trilhum (JARVIS-TRILHUM): projeto com os planos de estudo, só leitura. Padrão: D:\01_Projetos_Ativos\Trilha
JARVIS_TRILHUM_DIR=
# Plano quando o pedido não diz qual (ex.: rota40-oab-48); vazio = o plano em andamento
JARVIS_TRILHUM_PLANO=
# Progresso do Trilhum (só leitura) pela sincronização do app. Os três valores estão no Trilhum, em
# Configurações > Sincronização: o endereço (https://....supabase.co), a chave publishable e o token. O token dá
# acesso aos seus dados de estudo: guarde só aqui. O JARVIS só lê (trilha_sync_get), nunca grava.
JARVIS_TRILHUM_SYNC_URL=
JARVIS_TRILHUM_SYNC_CHAVE=
JARVIS_TRILHUM_SYNC_TOKEN=

# Aluno do Trilhum ULTRA (uma instância do JARVIS por aluno). Vazio = o dono, sem plano.
# haiku (R$ 20) | sonnet (R$ 35) | opus (R$ 50) | fable (R$ 75) | router (R$ 100). O aluno fica no modelo do plano.
JARVIS_PLANO=
# Teto mensal do aluno = preço do plano x fração / câmbio (Haiku US$ 1,82 ... Router US$ 9,09), com o modo economia
# a 80%. JARVIS_BUDGET_USD, se menor, vale no lugar.
# JARVIS_CAMBIO=5.5
# JARVIS_TETO_FRACAO=0.5
# Coach de constância (questionário do campo JARVIS do Trilhum): 1 por padrão com JARVIS_PLANO, 0 sem
# JARVIS_COACH=1

# Avisos pelo WhatsApp 30 minutos antes de cada bloco (0 = desligado). Número e consentimento LGPD: no Trilhum ficam
# em assinantes/{uid}.whatsapp e whatsappConsentimento; aqui, por enquanto, à mão. O número nunca vai ao Claude.
JARVIS_WHATSAPP_AVISOS=0
JARVIS_WHATSAPP_NUMERO=
# Data e hora do consentimento (ISO, ex.: 2026-11-02T10:00:00-03:00). Sem ela, nenhum aviso sai.
JARVIS_WHATSAPP_CONSENTIMENTO=
# Firestore do Trilhum como fonte do número e do consentimento (assinantes/{uid}, só leitura). Com o uid, valem
# o que o aluno ativou ou parou no app (relido a cada 5 min), e as duas variáveis acima são ignoradas. Falha na
# leitura, plano que não é "ultra" ou consentimento ausente = nenhum aviso. Usa o firebase-admin de
# Trilhaunctions
ode_modules (npm install lá) e o Node.
JARVIS_TRILHUM_UID=
# JARVIS_FIREBASE_PROJETO=trilha-estudos-2026
# Arquivo da conta de serviço do Firebase (fora do Git; só leitura basta: papel "Cloud Datastore Viewer")
JARVIS_FIREBASE_CREDENCIAIS=
# Modo teste: emulador local do Trilhum (python firebase/teste_local.py), projeto demo-trilhum
# JARVIS_FIRESTORE_EMULADOR=127.0.0.1:8085
# 1 = só registra no log (padrão, até a conta da Meta existir); 0 = manda pela Meta Cloud API
JARVIS_WHATSAPP_DRY_RUN=1
# JARVIS_WHATSAPP_ANTECEDENCIA_MIN=30
# 0 = não avisa nos feriados (o Trilhum mantém os blocos neles)
# JARVIS_WHATSAPP_FERIADO=1
# Meta Cloud API: token do app, id do número e modelo utilitário aprovado ({{1}} hora, {{2}} bloco, {{3}} assunto)
JARVIS_META_TOKEN=
JARVIS_META_NUMERO_ID=
# JARVIS_META_MODELO=aviso_bloco_estudo
# JARVIS_META_IDIOMA=pt_BR
# JARVIS_META_VERSAO=v23.0
# Minutos parados até a conversa ser arquivada e começar outra (a memória guarda a continuidade)
JARVIS_SESSAO_OCIOSA_MIN=30

# Opcional: salt da pseudonimização de nomes; se vazio, um é gerado em dados/.pii_salt
JARVIS_PII_SALT=

# Etapa 2: escuta por voz local, sem o HUD (0 = desligada; com 1 a API sobe e supervisiona python -m jarvis.voz).
# Antes de ligar: pip install -e .[voz,voz-gpu] e python -m jarvis.voz.baixar (uma vez, com internet).
JARVIS_VOZ_LOCAL=0
# Os opcionais abaixo ficam comentados: uma variável vazia não volta ao padrão.
# Modelos de voz e gravações de teste (fora do repositório). Padrão: D:\JARVIS-Voz
# JARVIS_VOZ_DIR=D:\JARVIS-Voz
# Parte do nome do microfone (python -m jarvis.voz --listar-microfones). Padrão: o do Windows
# JARVIS_VOZ_MICROFONE=K8
# 1 = modo fone: microfone aberto enquanto o JARVIS fala, para "Jarvis, pare" interromper (com alto-falante, 0)
# JARVIS_VOZ_INTERROMPER=1
# cpu = Whisper na CPU mesmo com GPU NVIDIA
# JARVIS_VOZ_DEVICE=cpu
# 1 = o texto transcrito vai para logs\voz.log (CPF/CNPJ mascarados). Padrão: só métricas
# JARVIS_VOZ_LOG_TEXTO=1
