# Copie para .env e preencha. O .env nunca vai para o git.

# Credencial da Anthropic (ou use `ant auth login`, que o SDK detecta sozinho)
ANTHROPIC_API_KEY=

# API local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_CORS=http://localhost:5299,http://127.0.0.1:5299
# Opcional: fixe o token do HUD; se vazio, um é gerado em dados/.token
JARVIS_TOKEN=

# Cérebro e orçamento
JARVIS_MODELO_SIMPLES=claude-haiku-5-5
JARVIS_MODELO_MEDIO=claude-sonnet-5-5
JARVIS_MODELO_COMPLEXO=claude-opus-5-5
# Topo da complexidade: Fable 5.1 (2,5x o preço do Opus). Pontuação mínima calibrada para ~5% das perguntas;
# suba para usar menos o Fable. O prefixo /fable força esta camada; no modo economia ela desce para o Opus.
JARVIS_MODELO_FABLE=claude-fable-5-1
JARVIS_FABLE_PONTOS=4
JARVIS_BUDGET_USD=30
JARVIS_NOME=Senhor

# Proatividade: monitores, lembretes e notificações do Windows (0 desliga)
JARVIS_PROATIVO=1
# Pastas que as ferramentas de arquivo podem ler e de onde o JARVIS pode mover arquivos (separadas por ;).
# Vazio = padrão: Documents, OneDrive\Documentos, Downloads, Desktop, OneDrive\Desktop,
# OneDrive\Área de Trabalho (as que existirem) e a pasta do projeto.
# ATENÇÃO: definir esta variável SUBSTITUI a lista padrão inteira, não soma a ela. Liste todas as pastas que
# quiser manter. Pasta inexistente é ignorada sem aviso. JARVIS_ARQUIVO continua sendo somado para leitura.
# Exemplo (mantém Documentos e Downloads, troca o Desktop por D:\Projetos):
# JARVIS_PASTAS=C:\Users\Veloso\Documents;C:\Users\Veloso\Downloads;D:\Projetos
JARVIS_PASTAS=
# Para onde o JARVIS move arquivos (reversível) e salva os arquivos gerados. Padrão: D:\JARVIS-Arquivo
JARVIS_ARQUIVO=
# Base de conhecimento do especialista (uma subpasta por área). Padrão: D:\JARVIS-Conhecimento
JARVIS_CONHECIMENTO=
# Minutos parados até a conversa ser arquivada e começar outra (a memória guarda a continuidade)
JARVIS_SESSAO_OCIOSA_MIN=30

# Opcional: salt da pseudonimização de nomes; se vazio, um é gerado em dados/.pii_salt
JARVIS_PII_SALT=

# Etapa 2: escuta por voz local, sem o HUD (0 = desligada; com 1 a API sobe e supervisiona python -m jarvis.voz).
# Antes de ligar: pip install -e .[voz,voz-gpu] e python -m jarvis.voz.baixar (uma vez, com internet).
JARVIS_VOZ_LOCAL=0
# Os opcionais abaixo ficam comentados: uma variável vazia não volta ao padrão.
# Modelos de voz e gravações de teste (fora do repositório). Padrão: D:\JARVIS-Voz
# JARVIS_VOZ_DIR=D:\JARVIS-Voz
# Parte do nome do microfone (python -m jarvis.voz --listar-microfones). Padrão: o do Windows
# JARVIS_VOZ_MICROFONE=K8
# 1 = modo fone: microfone aberto enquanto o JARVIS fala, para "Jarvis, pare" interromper (com alto-falante, 0)
# JARVIS_VOZ_INTERROMPER=1
# cpu = Whisper na CPU mesmo com GPU NVIDIA
# JARVIS_VOZ_DEVICE=cpu
# 1 = o texto transcrito vai para logs\voz.log (CPF/CNPJ mascarados). Padrão: só métricas
# JARVIS_VOZ_LOG_TEXTO=1

# Painel fiscal do HUD: card tributário e card do cliente (0 desliga rotas e coleta)
JARVIS_PAINEL=1
# Minutos entre as coletas das fontes oficiais (config/fontes_fiscais.json) e das fontes de clientes
JARVIS_FISCAL_INTERVALO_MIN=360
JARVIS_CLIENTES_INTERVALO_MIN=1440
# Fontes de dados do cliente além do banco do JARVIS (todas opcionais; os opcionais ficam comentados).
# Planilha local (.csv; .xlsx precisa de pip install -e .[painel]) OU Google Sheets publicado em CSV (https):
# JARVIS_CLIENTES_PLANILHA=D:\Clientes\clientes.csv
# JARVIS_CLIENTES_SHEETS_URL=https://docs.google.com/spreadsheets/d/<id>/export?format=csv
# ERP por API (https); o formato fica em config/clientes_fontes.json. O token nunca vai para o código nem para o log:
# JARVIS_ERP_URL=https://erp.exemplo.com.br/api
# JARVIS_ERP_TOKEN=
# Portais oficiais: Consulta CNPJ do SERPRO pelo cliente em D:\integracoes (precisa do pacote requests e das
# credenciais SERPRO_CONSUMER_KEY, SERPRO_CONSUMER_SECRET e SERPRO_AUDIT_SALT; consulta paga, uma vez por dia):
# JARVIS_SERPRO_CLIENTE=D:\integracoes\serpro\serpro_client.py
# SERPRO_CONSUMER_KEY=
# SERPRO_CONSUMER_SECRET=
# SERPRO_AUDIT_SALT=
